---
const projects = [
  {
    title: "NovLink",
    category: "Aplikasi Web · Next.js",
    description: "Layanan pemendek tautan dengan slug khusus, redirect cepat, dan masa aktif tujuh hari untuk setiap tautan.",
    stack: "Next.js · Vercel",
    image: "/assets/project-novlink.jpg",
    link: "https://sl.noov.app/"
  },
  {
    title: "Roller Customize",
    category: "Website Bisnis · Next.js",
    description: "Website konveksi untuk memperkenalkan layanan, katalog produk, daftar harga, dan alur konsultasi pelanggan.",
    stack: "Next.js · Responsive Web",
    image: "/assets/project-roller-customize.webp",
    link: "https://rollercustomize.com/"
  }
];
const summary = "Dua proyek web yang sudah tayang dan saya kerjakan dari hulu ke hilir, mulai dari konsep hingga deployment.";
---

<section class="works-section" id="projects">
  <div class="container-wide">
    <div class="section-header">
      <div class="section-heading">
        <div class="section-dash"></div>
        <h2 class="section-label-text">Proyek Pilihan</h2>
      </div>
      <p class="section-summary" data-words>
        {summary.split(/\s+/).map((word, index, words) => (
          <>
            <span class="word">{word}</span>
            {index < words.length - 1 ? ' ' : ''}
          </>
        ))}
      </p>
    </div>

    <div class="works-grid">
      {projects.map((project) => (
        <a
          href={project.link}
          class="work-card"
          data-cursor-hover="work"
          data-reveal
          target={project.link.startsWith('http') ? '_blank' : undefined}
          rel={project.link.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <div class="work-media">
            <img src={project.image} alt={`Tampilan antarmuka ${project.title}`} class="work-image" width="1440" height="1080" loading="lazy" />
            <div class="work-note">
              <p>{project.description}</p>
              <span>{project.stack}</span>
            </div>
          </div>
          <div class="work-meta">
            <div class="work-meta-row">
              <h5>{project.title}</h5>
              <svg class="work-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7M17 7H9M17 7V15"></path>
              </svg>
            </div>
            <p>{project.category}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .works-section {
    width: 100%;
    display: flex;
    justify-content: center;
    background: var(--bg);
  }

  .works-section .container-wide {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 80px;
    padding: 80px;
  }

  .works-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(50px, 1fr));
    gap: 24px;
  }

  .work-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 12px;
    border: 1px solid var(--project-edge);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text);
    text-decoration: none;
  }

  .work-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    background: var(--bg-subtle);
  }

  .work-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: grayscale(1) brightness(0.97);
    transition: transform 0.7s var(--ease-out), filter 0.45s var(--ease-out);
  }

  .work-card:hover .work-image,
  .work-card:focus-visible .work-image {
    transform: scale(1.02);
    filter: grayscale(1) brightness(0.86) blur(5px);
  }

  .work-note {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 32px;
    background: rgba(18, 18, 18, 0.35);
    color: #fff;
    text-align: center;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
    pointer-events: none;
  }

  .work-note p {
    max-width: 420px;
    font-size: 15px;
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.03em;
  }

  .work-note span {
    color: rgba(255, 255, 255, 0.72);
    font-size: 13px;
    line-height: 140%;
    letter-spacing: -0.02em;
  }

  .work-card:hover .work-note,
  .work-card:focus-visible .work-note {
    opacity: 1;
    transform: translateY(0);
  }

  .work-meta {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    padding: 0 2px;
  }

  .work-meta-row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .work-meta h5 {
    color: var(--text);
    font-size: var(--fs-h5);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.05em;
  }

  .work-meta > p {
    color: var(--text-muted);
    font-size: 16px;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .work-arrow {
    flex: none;
    color: var(--text-muted);
    transition: transform 0.35s var(--ease-out), color 0.35s var(--ease-out);
  }

  .work-card:hover .work-arrow,
  .work-card:focus-visible .work-arrow {
    transform: translate(2px, -2px);
    color: var(--text);
  }

  @media (max-width: 1199.98px) {
    .works-section .container-wide {
      gap: 48px;
      padding: 80px 40px;
    }

    .works-grid {
      gap: 20px;
    }
  }

  @media (max-width: 809.98px) {
    .works-section .container-wide {
      gap: 40px;
      padding: 64px 24px;
    }

    .works-grid {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .work-media {
      min-height: 220px;
    }

    .work-note {
      position: absolute;
      inset: auto 0 0 0;
      align-items: flex-start;
      text-align: left;
      gap: 4px;
      padding: 14px 16px;
      background: rgba(18, 18, 18, 0.55);
      opacity: 1;
      transform: translateY(0);
    }

    .work-note p {
      max-width: none;
      font-size: 14px;
    }
  }
</style>
