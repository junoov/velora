---
const projects = [
  {
    title: "Cafe POS",
    monogram: "CP",
    category: "Full-Stack · TypeScript",
    description: "Aplikasi point-of-sale untuk membantu operasional kafe.",
    stack: "TypeScript",
    link: "https://github.com/junoov/pos-system-cafe"
  },
  {
    title: "Auraquina Juni",
    monogram: "AJ",
    category: "Full-Stack · PHP",
    description: "Aplikasi web full-stack berbasis PHP dan Blade, dikemas dengan Docker.",
    stack: "PHP · Blade · Docker",
    link: "https://github.com/junoov/auraquina-juni"
  },
  {
    title: "Proyek Kita",
    monogram: "PK",
    category: "Web · Astro",
    description: "Proyek web berbasis Astro dan TypeScript yang sudah tayang di Vercel.",
    stack: "Astro · TypeScript · Vercel",
    link: "https://proyek-kita.vercel.app"
  },
  {
    title: "Velora Rebuild",
    monogram: "VR",
    category: "Frontend · Astro",
    description: "Rebuild template Velora ke Astro dengan animasi scroll hasil reverse engineering.",
    stack: "Astro · GSAP · Lenis",
    link: "https://github.com/junoov/velora"
  }
];
const summary = "Kumpulan proyek pilihan di bidang frontend, backend, dan deployment. Kode sumber dan demo tayang tersedia di GitHub.";
---

<section class="works-section" id="projects">
  <div class="container-wide">
    <div class="section-header">
      <div class="section-heading">
        <div class="section-dash"></div>
        <h2 class="section-label-text">Proyek Pilihan</h2>
      </div>
      <p class="section-summary" data-words>
        {summary.split(/\s+/).map((word, index, words) => (
          <>
            <span class="word">{word}</span>
            {index < words.length - 1 ? ' ' : ''}
          </>
        ))}
      </p>
    </div>

    <div class="works-grid">
      {projects.map((project) => (
        <a
          href={project.link}
          class="work-card"
          data-cursor-hover="work"
          data-reveal
          target={project.link.startsWith('http') ? '_blank' : undefined}
          rel={project.link.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <div class="work-image-wrap">
            <div class="work-cover">
              <span class="work-monogram" aria-hidden="true">{project.monogram}</span>
            </div>
            <div class="work-overlay">
              <h6>{project.description}</h6>
              <p class="work-stack">{project.stack}</p>
            </div>
          </div>
          <div class="work-meta">
            <h5>{project.title}</h5>
            <p>{project.category}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .works-section {
    width: 100%;
    display: flex;
    justify-content: center;
    background: var(--bg);
  }

  .works-section .container-wide {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 80px;
    padding: 80px;
  }

  .works-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(50px, 1fr));
    gap: 24px;
  }

  .work-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 12px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text);
    text-decoration: none;
  }

  .work-image-wrap {
    position: relative;
    width: 100%;
    min-height: 250px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    background: var(--bg-subtle);
  }

  .work-cover {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    background: var(--bg-subtle);
  }

  .work-monogram {
    color: var(--text-faint);
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 500;
    letter-spacing: -0.06em;
    transition: transform 0.7s var(--ease-out);
  }

  .work-card:hover .work-monogram,
  .work-card:focus-visible .work-monogram {
    transform: scale(1.08);
  }

  .work-stack {
    color: rgba(255, 255, 255, 0.75);
    font-size: 14px;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.03em;
  }

  .work-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 40px;
    opacity: 0;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    text-align: center;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    transition: opacity 0.4s ease;
  }

  .work-overlay h6 {
    max-width: 500px;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.05em;
  }

  .work-card:hover .work-overlay,
  .work-card:focus-visible .work-overlay {
    opacity: 1;
  }

  .work-meta {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 4px;
  }

  .work-meta h5 {
    color: var(--text);
    font-size: var(--fs-h5);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.05em;
  }

  .work-meta p {
    color: var(--text-muted);
    font-size: 16px;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  @media (max-width: 1199.98px) {
    .works-section .container-wide {
      gap: 48px;
      padding: 80px 40px;
    }

    .works-grid {
      gap: 20px;
    }
  }

  @media (max-width: 809.98px) {
    .works-section .container-wide {
      gap: 40px;
      padding: 64px 24px;
    }

    .works-grid {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .work-card {
      flex: none;
    }

    .work-overlay {
      padding: 24px;
    }
  }
</style>
