---
const experiences = [
  {
    role: "Asisten Praktikum",
    company: "Komunikasi Data & Jaringan Komputer (KDJK)",
    period: "Semester 6 · 2026",
    description: "Mendampingi mahasiswa selama sesi praktikum jaringan komputer dengan perangkat Cisco, mencakup subnetting, routing, switching, dan troubleshooting konfigurasi jaringan. Ikut menilai laporan praktikum serta membantu mahasiswa yang mengalami kendala."
  },
  {
    role: "Asisten Praktikum",
    company: "Pemrograman Web",
    period: "Semester 6 · 2026",
    description: "Mendampingi mahasiswa selama sesi praktikum pemrograman web. Menjelaskan konsep frontend dan backend, memeriksa tugas, serta membantu memperbaiki error pada kode mahasiswa."
  }
];
---

<section class="about-section" id="about">
  <div class="about-container">
    <div class="about-summary">
      <div class="about-heading" data-reveal>
        <div class="section-dash"></div>
        <h2 class="section-label-text">Tentang Saya</h2>
      </div>

      <div class="about-bio-wrap">
        <p class="about-bio" data-reveal>
          Saya seorang pengembang web full-stack yang senang membangun aplikasi secara utuh, dari antarmuka hingga database. Latar belakang saya di jaringan komputer dan keamanan web membentuk cara saya merancang serta menjaga kualitas perangkat lunak.
        </p>
        <a href="mailto:rizkynoviansyah20@gmail.com" class="about-contact" data-reveal>
          <span>Hubungi saya</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="about-education" data-reveal>
        <p class="about-education-label">Pendidikan</p>
        <h4 class="about-education-title">S1 Informatika</h4>
        <p class="about-education-detail">Universitas Ahmad Dahlan · 2023 - sekarang</p>
      </div>
    </div>

    <div class="experience-list">
      <div class="experience-label" data-reveal>
        <div class="section-dash"></div>
        <h2 class="section-label-text">Pengalaman</h2>
      </div>

      {experiences.map((experience, index) => (
        <div class="experience-item" data-reveal>
          <div class="experience-top">
            <div class="experience-main">
              <h6>{experience.role}</h6>
              <p>{experience.company}</p>
            </div>
            <div class="experience-secondary">
              <p>{experience.period}</p>
            </div>
          </div>
          <div class="experience-content">
            <p>{experience.description}</p>
          </div>
          <span class="experience-line" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-section {
    width: 100%;
    display: flex;
    justify-content: center;
    background: var(--bg);
  }

  .about-container {
    width: 100%;
    max-width: var(--max-w);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding: 80px;
  }

  .about-summary {
    position: sticky;
    top: 64px;
    z-index: 1;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    overflow: hidden;
  }

  .about-summary > .about-bio-wrap {
    /* Live: label row (34px) -> name gap 23px; bio->CTA gap 58px (24px flex gap + 34px margin) */
    margin-top: 23px;
  }

  .about-heading {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 10px;
  }

  .about-bio-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .about-bio {
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .about-contact {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 34px;
    padding: 4px 4px 4px 0;
    color: var(--text);
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .about-contact::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: var(--text);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 0.4s var(--ease-link), transform 0.4s var(--ease-link);
  }

  .about-contact:hover::after,
  .about-contact:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .about-contact svg {
    transition: transform 0.4s var(--ease-link);
  }

  .about-contact:hover svg,
  .about-contact:focus-visible svg {
    transform: translateX(3px);
  }

  .about-education {
    width: 100%;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .about-education-label {
    color: var(--text-faint);
    font-size: 13px;
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .about-education-title {
    margin-top: 8px;
    color: var(--text);
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .about-education-detail {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .experience-list {
    width: 100%;
    max-width: 550px;
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-bottom: 24px;
    overflow: hidden;
  }

  .experience-label {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 10px;
  }

  .experience-item {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 0 24px;
  }

  .experience-top {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .experience-main {
    width: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .experience-main h6 {
    width: 100%;
    color: var(--text);
    font-size: var(--fs-h5);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.05em;
  }

  .experience-main p,
  .experience-secondary p {
    width: 100%;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .experience-secondary {
    align-self: stretch;
    width: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
  }

  .experience-secondary p {
    text-align: right;
  }

  .experience-content {
    width: 100%;
    max-width: 500px;
    color: var(--text-muted);
  }

  .experience-content p {
    width: 100%;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .experience-line {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--line);
  }

  @media (max-width: 1199.98px) {
    .about-container {
      flex-direction: column;
      justify-content: flex-start;
      gap: 80px;
      padding: 80px 40px;
    }

    .about-summary {
      position: relative;
      top: auto;
      max-width: 600px;
      flex: none;
      width: 100%;
      gap: 24px;
    }

    .about-summary > .about-bio-wrap {
      margin-top: 0;
    }

    .about-contact {
      margin-top: 0;
    }

    .about-education {
      margin-top: 32px;
      padding-top: 20px;
    }

    .experience-list {
      max-width: none;
      flex: none;
      width: 100%;
    }
  }

  @media (max-width: 809.98px) {
    .about-container {
      gap: 40px;
      padding: 64px 24px;
    }

    .about-summary {
      gap: 20px;
    }

    .about-summary > .about-bio-wrap {
      margin-top: 0;
    }

    .about-contact {
      margin-top: 0;
    }

    .about-bio-wrap {
      gap: 20px;
    }

    .experience-list {
      gap: 24px;
    }

    .experience-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding-bottom: 20px;
    }

    .experience-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .experience-main {
      width: 100%;
      flex: none;
      gap: 0;
    }

    .experience-content {
      width: 100%;
      max-width: none;
    }

    .experience-secondary {
      align-self: unset;
      width: 100%;
      height: auto;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      flex: none;
    }

    .experience-secondary p {
      width: 100%;
      text-align: left;
      font-size: 14px;
      line-height: 140%;
    }
  }
</style>
