---
const experiences = [
  {
    role: "Senior Product Designer",
    company: "Visionary Labs",
    period: "2024 - Present"
  },
  {
    role: "UI/UX Designer",
    company: "Creative Hive Agency",
    period: "2022-2024"
  },
  {
    role: "Motion Graphics Designer",
    company: "PixelWave Studios",
    period: "2021"
  },
  {
    role: "Graphic Designer",
    company: "DesignCraft Inc.",
    period: "2020"
  },
  {
    role: "Design Intern",
    company: "ArtiFlex Solutions",
    period: "2018-2019"
  }
];
---

<section class="about-section" id="about">
  <div class="about-container">
    <div class="about-summary">
      <div class="about-heading" data-reveal>
        <div class="section-dash"></div>
        <h2 class="section-label-text">About Me</h2>
      </div>

      <div class="about-bio-wrap">
        <h3 class="about-name" data-reveal>Jane Smith</h3>
        <p class="about-bio" data-reveal>
          I specialize in turning complex problems into seamless designs, from research to high-fidelity prototypes. Passionate about usability and design systems, I collaborate with teams to build products that are both beautiful and functional.
        </p>
        <a href="mailto:hello.lunis.design@gmail.com" class="about-contact" data-reveal>
          <span>Contact me</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <div class="experience-list">
      {experiences.map((experience) => (
        <div class="experience-item" tabindex="0" role="button" data-reveal>
          <div class="experience-main">
            <h6>{experience.role}</h6>
            <p>{experience.company}</p>
          </div>
          <div class="experience-secondary">
            <p>{experience.period}</p>
            <span class="experience-plus" aria-hidden="true"></span>
          </div>
          <span class="experience-line" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-section {
    width: 100%;
    display: flex;
    justify-content: center;
    background: var(--bg);
  }

  .about-container {
    width: 100%;
    max-width: var(--max-w);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding: 80px;
  }

  .about-summary {
    position: sticky;
    top: 64px;
    z-index: 1;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    overflow: hidden;
  }

  .about-summary > .about-bio-wrap {
    /* Live: label row (34px) -> name gap 23px; bio->CTA gap 58px (24px flex gap + 34px margin) */
    margin-top: 23px;
  }

  .about-heading {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 10px;
  }

  .about-bio-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .about-name {
    color: var(--text);
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 120%;
    letter-spacing: -0.06em;
  }

  .about-bio {
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .about-contact {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 34px;
    padding: 4px 4px 4px 0;
    color: var(--text);
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .about-contact::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: var(--text);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 0.4s var(--ease-link), transform 0.4s var(--ease-link);
  }

  .about-contact:hover::after,
  .about-contact:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .about-contact svg {
    transition: transform 0.4s var(--ease-link);
  }

  .about-contact:hover svg,
  .about-contact:focus-visible svg {
    transform: translateX(3px);
  }

  .experience-list {
    width: 100%;
    max-width: 550px;
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-bottom: 24px;
    overflow: hidden;
  }

  .experience-item {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 24px;
    padding: 0 0 24px;
    cursor: pointer;
  }

  .experience-main {
    width: 1px;
    display: flex;
    flex: 2 0 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .experience-main h6 {
    width: 100%;
    color: var(--text);
    font-size: var(--fs-h6);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.05em;
  }

  .experience-main p,
  .experience-secondary p {
    width: 100%;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .experience-secondary {
    align-self: stretch;
    width: 1px;
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
  }

  .experience-secondary p {
    text-align: right;
  }

  .experience-plus {
    position: relative;
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--text-muted);
  }

  .experience-plus::before,
  .experience-plus::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    content: "";
    transform: translate(-50%, -50%);
  }

  .experience-plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .experience-line {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--line);
  }

  .experience-item::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    height: 1px;
    background: var(--line-hover);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-link);
  }

  .experience-item:hover::after,
  .experience-item:focus-visible::after {
    transform: scaleX(1);
  }

  @media (max-width: 1199.98px) {
    .about-container {
      flex-direction: column;
      justify-content: flex-start;
      gap: 80px;
      padding: 80px 40px;
    }

    .about-summary {
      position: relative;
      top: auto;
      max-width: 600px;
      flex: none;
      width: 100%;
      gap: 24px;
    }

    .about-summary > .about-bio-wrap {
      margin-top: 0;
    }

    .about-contact {
      margin-top: 0;
    }

    .experience-list {
      max-width: none;
      flex: none;
      width: 100%;
    }
  }

  @media (max-width: 809.98px) {
    .about-container {
      gap: 40px;
      padding: 64px 24px;
    }

    .about-summary {
      gap: 20px;
    }

    .about-summary > .about-bio-wrap {
      margin-top: 0;
    }

    .about-contact {
      margin-top: 0;
    }

    .about-bio-wrap {
      gap: 20px;
    }

    .experience-list {
      gap: 24px;
    }

    .experience-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding-bottom: 20px;
    }

    .experience-main {
      order: 1;
      width: 100%;
      flex: none;
      gap: 0;
    }

    .experience-secondary {
      order: 0;
      align-self: unset;
      width: 100%;
      height: auto;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex: none;
    }

    .experience-secondary p {
      width: 100%;
      text-align: left;
      font-size: 14px;
      line-height: 140%;
    }
  }
</style>
