---
const experiences = [
  {
    role: "Asisten Praktikum",
    company: "Komunikasi Data & Jaringan Komputer (KDJK)",
    period: "Semester 6 · 2026",
    description: "Mendampingi mahasiswa selama sesi praktikum jaringan komputer dengan perangkat Cisco. MATERI: subnetting, routing, switching, dan troubleshooting konfigurasi jaringan. Ikut menilai laporan praktikum serta membantu mahasiswa yang mengalami kendala."
  },
  {
    role: "Asisten Praktikum",
    company: "Pemrograman Web",
    period: "Semester 6 · 2026",
    description: "Mendampingi mahasiswa selama sesi praktikum pemrograman web. Menjelaskan konsep frontend dan backend, memeriksa tugas, serta membantu memperbaiki error pada kode mahasiswa."
  }
];
---

<section class="about-section" id="about">
  <div class="about-container">
    <div class="about-summary">
      <div class="about-heading" data-reveal>
        <div class="section-dash"></div>
        <h2 class="section-label-text">Pengalaman</h2>
      </div>

      <div class="about-bio-wrap">
        <h3 class="about-name" data-reveal>Rizky Noviansyah</h3>
        <p class="about-bio" data-reveal>
          Saya seorang pengembang web full-stack yang senang membangun aplikasi secara utuh, dari antarmuka, API, hingga database. Latar belakang saya di jaringan komputer dan keamanan web membentuk cara saya merancang serta menjaga kualitas perangkat lunak.
        </p>
        <a href="mailto:rizkynoviansyah20@gmail.com" class="about-contact" data-reveal>
          <span>Hubungi saya</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <div class="experience-list">
      {experiences.map((experience, index) => (
        <div
          class="experience-item"
          tabindex="0"
          role="button"
          aria-expanded="false"
          aria-controls={`experience-content-${index}`}
          data-experience
          data-reveal
        >
          <div class="experience-main">
            <h6>{experience.role}</h6>
            <p>{experience.company}</p>
          </div>
          <div class="experience-secondary">
            <p>{experience.period}</p>
            <svg class="experience-plus" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3.75 12H20.25M12 3.75V20.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
          <div class="experience-content" id={`experience-content-${index}`} aria-hidden="true">
            <p>{experience.description}</p>
          </div>
          <span class="experience-line" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-section {
    width: 100%;
    display: flex;
    justify-content: center;
    background: var(--bg);
  }

  .about-container {
    width: 100%;
    max-width: var(--max-w);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding: 80px;
  }

  .about-summary {
    position: sticky;
    top: 64px;
    z-index: 1;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    overflow: hidden;
  }

  .about-summary > .about-bio-wrap {
    /* Live: label row (34px) -> name gap 23px; bio->CTA gap 58px (24px flex gap + 34px margin) */
    margin-top: 23px;
  }

  .about-heading {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 10px;
  }

  .about-bio-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .about-name {
    color: var(--text);
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 120%;
    letter-spacing: -0.06em;
  }

  .about-bio {
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .about-contact {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 34px;
    padding: 4px 4px 4px 0;
    color: var(--text);
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .about-contact::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: var(--text);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 0.4s var(--ease-link), transform 0.4s var(--ease-link);
  }

  .about-contact:hover::after,
  .about-contact:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .about-contact svg {
    transition: transform 0.4s var(--ease-link);
  }

  .about-contact:hover svg,
  .about-contact:focus-visible svg {
    transform: translateX(3px);
  }

  .experience-list {
    width: 100%;
    max-width: 550px;
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-bottom: 24px;
    overflow: hidden;
  }

  .experience-item {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    column-gap: 24px;
    row-gap: 0;
    padding: 0 0 24px;
    cursor: pointer;
    outline: none;
  }

  .experience-main {
    width: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .experience-main h6 {
    width: 100%;
    color: var(--text);
    font-size: var(--fs-h6);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.05em;
  }

  .experience-main p,
  .experience-secondary p {
    width: 100%;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .experience-secondary {
    align-self: stretch;
    width: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
  }

  .experience-secondary p {
    text-align: right;
  }

  .experience-plus {
    display: block;
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--line-hover);
    transform-origin: center;
    transition: transform 0.45s var(--ease-link);
  }

  .experience-item.is-expanded .experience-plus {
    transform: rotate(45deg);
  }

  .experience-content {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 500px;
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    color: var(--text-muted);
    opacity: 0;
    visibility: hidden;
    transition: max-height 0.55s var(--ease-out), margin-top 0.55s var(--ease-out), opacity 0.35s var(--ease-link), visibility 0s linear 0.55s;
  }

  .experience-content p {
    width: 100%;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .experience-item.is-expanded .experience-content {
    max-height: 240px;
    margin-top: 16px;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .experience-item:focus-visible {
    outline: 1px solid var(--line-hover);
    outline-offset: 4px;
  }

  /* The icon is a stroked plus, matching the source site's 24px symbol. */
  .experience-plus path {
    fill: none;
  }

  .experience-plus {
    width: 20px;
  }

  .experience-line {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--line);
  }

  .experience-item::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    height: 1px;
    background: var(--line-hover);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-link);
  }

  .experience-item:hover::after,
  .experience-item:focus-visible::after {
    transform: scaleX(1);
  }

  @media (max-width: 1199.98px) {
    .about-container {
      flex-direction: column;
      justify-content: flex-start;
      gap: 80px;
      padding: 80px 40px;
    }

    .about-summary {
      position: relative;
      top: auto;
      max-width: 600px;
      flex: none;
      width: 100%;
      gap: 24px;
    }

    .about-summary > .about-bio-wrap {
      margin-top: 0;
    }

    .about-contact {
      margin-top: 0;
    }

    .experience-list {
      max-width: none;
      flex: none;
      width: 100%;
    }
  }

  @media (max-width: 809.98px) {
    .about-container {
      gap: 40px;
      padding: 64px 24px;
    }

    .about-summary {
      gap: 20px;
    }

    .about-summary > .about-bio-wrap {
      margin-top: 0;
    }

    .about-contact {
      margin-top: 0;
    }

    .about-bio-wrap {
      gap: 20px;
    }

    .experience-list {
      gap: 24px;
    }

    .experience-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-bottom: 20px;
    }

    .experience-main {
      order: 1;
      width: 100%;
      flex: none;
      margin-top: 8px;
      gap: 0;
    }

    .experience-content {
      order: 2;
      width: 100%;
      max-width: none;
    }

    .experience-item.is-expanded .experience-content {
      margin-top: 16px;
    }

    .experience-secondary {
      order: 0;
      align-self: unset;
      width: 100%;
      height: auto;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex: none;
    }

    .experience-secondary p {
      width: 100%;
      text-align: left;
      font-size: 14px;
      line-height: 140%;
    }
  }
</style>

<script>
  const experienceItems = Array.from(document.querySelectorAll<HTMLElement>('[data-experience]'));

  const setExperienceState = (item: HTMLElement, expanded: boolean) => {
    experienceItems.forEach((other) => {
      const isCurrent = other === item;
      const isExpanded = isCurrent && expanded;
      const contentId = other.getAttribute('aria-controls');
      const content = contentId ? document.getElementById(contentId) : null;

      other.classList.toggle('is-expanded', isExpanded);
      other.setAttribute('aria-expanded', String(isExpanded));
      content?.setAttribute('aria-hidden', String(!isExpanded));
    });

    window.setTimeout(() => window.__veloraMotion?.refresh(), 600);
  };

  experienceItems.forEach((item) => {
    item.addEventListener('click', () => {
      setExperienceState(item, !item.classList.contains('is-expanded'));
    });

    item.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;

      event.preventDefault();
      setExperienceState(item, !item.classList.contains('is-expanded'));
    });
  });
</script>
