---
const reviews = [
  {
    quote: "Clean, professional, and easy to use. Velora gave my agency the polished online presence it needed.\"",
    author: "John Doe",
    role: "Marketing Specialist, DreamLive",
    avatar: "/assets/avatar-john.jpeg"
  },
  {
    quote: "A perfect balance of style and functionality. My clients love the new look of my website!\"",
    author: "Emily Lin",
    role: "Freelance Photographer",
    avatar: "/assets/avatar-emily.jpeg"
  },
  {
    quote: "Velora made launching my portfolio effortless. The design is stunning, and customization was a breeze!",
    author: "Sarah Roberts",
    role: "Freelance Designer",
    avatar: "/assets/avatar-sarah.jpeg"
  }
];
const summary = "Worked with numerous brands and professionals, I helped over 100 businesses launch their websites.";
---

<section class="reviews-section" id="review">
  <div class="reviews-container">
    <div class="reviews-header">
      <div class="section-heading">
        <div class="section-dash"></div>
        <h2 class="section-label-text">What People Say</h2>
      </div>
      <p class="reviews-summary" data-words>
        {summary.split(/\s+/).map((word, index, words) => (
          <>
            <span class="word">{word}</span>
            {index < words.length - 1 ? ' ' : ''}
          </>
        ))}
      </p>
    </div>

    <div class="reviews-placeholder" aria-hidden="true"></div>

    <div class="reviews-carousel">
      <div class="carousel-viewport" id="carouselViewport">
        <div class="carousel-track" id="carouselTrack">
          {reviews.map((review) => (
                <article class="review-card">
                  <div class="review-quote-wrap">
                    <svg class="quote-icon" width="31" height="24" viewBox="0 0 31 24" fill="none" aria-hidden="true">
                      <path fill="currentColor" d="M0.1 5.2C0.1 3.8 0.7 2.6 1.8 1.6C2.9 0.5 4.2 0 5.7 0C6.4 0 7 0.1 7.8 0.4L7.6 0.3L8.4 0.6H8.5C8.7 0.8 9 1 9.3 1.2C9.3 1.2 9.4 1.4 9.7 1.6C11.7 3.4 12.5 6 12.2 9.6C11.9 14.7 8.8 19.3 3.1 23.5C2.8 23.7 2.4 23.9 2 23.9C1.4 23.9 0.9 23.6 0.5 23.1C-0.3 22.3 -0.1 21.5 0.8 20.8C5.5 17.4 8.1 13.7 8.5 9.7C7.6 10.2 6.7 10.5 5.7 10.5C4.2 10.5 2.9 10 1.8 9C0.7 7.9 0.1 6.6 0.1 5.2ZM18.6 5.2C18.6 3.8 19.2 2.6 20.3 1.6C21.4 0.5 22.8 0 24.3 0C24.9 0 25.6 0.1 26.3 0.4L26.2 0.3L26.9 0.6H27C27.3 0.8 27.5 1 27.8 1.2C27.9 1.2 28 1.4 28.2 1.6C30.2 3.4 31.1 6 30.8 9.6C30.4 14.7 27.4 19.3 21.6 23.5C21.3 23.7 21 23.9 20.6 23.9C19.9 23.9 19.4 23.6 19.1 23.1C18.3 22.3 18.4 21.5 19.4 20.8C24.1 17.4 26.6 13.7 27.1 9.7C26.2 10.2 25.2 10.5 24.3 10.5C22.8 10.5 21.4 10 20.3 9C19.2 7.9 18.6 6.6 18.6 5.2Z" />
                    </svg>
                    <h5>{review.quote}</h5>
                  </div>

                  <div class="review-author">
                    <img src={review.avatar} alt={review.author} width="46" height="46" loading="lazy" />
                    <div class="review-author-info">
                      <p>{review.author}</p>
                      <p>{review.role}</p>
                    </div>
                  </div>
                </article>
          ))}
        </div>
      </div>
      <div class="carousel-pagination" aria-label="Slideshow pagination controls">
        {reviews.map((_, index) => (
          <button type="button" aria-label={`Scroll to page ${index + 1}`} aria-current={index === 0 ? "true" : undefined} data-slide={index}>
            <span></span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
    background: var(--bg);
  }

  .reviews-container {
    width: 100%;
    max-width: var(--max-w);
    display: grid;
    grid-template-columns: repeat(9, minmax(50px, 1fr));
    align-items: start;
    gap: 24px;
    padding: 80px;
  }

  .reviews-header {
    grid-column: span 3;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .reviews-header .section-heading {
    width: 90%;
    flex: none;
  }

  .reviews-summary {
    width: 100%;
    max-width: 485px;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
    text-align: left;
  }

  .reviews-summary .word {
    display: inline-block;
    will-change: transform, opacity, filter;
  }

  .reviews-placeholder {
    grid-column: span 1;
    width: 100%;
    height: 100%;
  }

  .reviews-carousel {
    position: relative;
    grid-column: span 5;
    width: 100%;
    /* Live: card pitch 611px, viewport runs to the container's right edge (x=1340) so the
       next card peeks ~39px (its content starts at x~1301). */
    max-width: 678px;
    height: 420px;
    overflow: visible;
  }

  .carousel-viewport {
    width: 100%;
    height: 360px;
    overflow: hidden;
    border-radius: 8px;
    perspective: 1200px;
    user-select: none;
  }

  .carousel-track {
    display: flex;
    align-items: stretch;
    gap: 10px;
    height: 360px;
    cursor: grab;
    will-change: transform;
    touch-action: pan-y;
  }

  .carousel-track:active {
    cursor: grabbing;
  }

  .review-card {
    width: 90.1%;
    min-width: 90.1%;
    height: 360px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: 24px;
    overflow: hidden;
    border-radius: 8px;
    background: var(--bg-card);
  }

  .review-quote-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 4px;
  }

  .quote-icon {
    flex: none;
    color: #e6e6e6;
  }

  .review-quote-wrap h5 {
    width: 100%;
    color: var(--text);
    font-size: var(--fs-h5);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.05em;
  }

  .review-author {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px;
  }

  .review-author img {
    width: 46px;
    height: 46px;
    flex: none;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 50%;
    object-fit: cover;
  }

  .review-author-info {
    min-width: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    overflow: hidden;
  }

  .review-author-info p {
    width: 100%;
    color: var(--text);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .review-author-info p + p {
    color: var(--text-muted);
  }

  .carousel-pagination {
    position: absolute;
    bottom: 12px;
    left: 50%;
    display: flex;
    overflow: hidden;
    border-radius: 50px;
    background: rgba(0, 0, 0, 0.2);
    transform: translateX(-50%);
  }

  .carousel-pagination button {
    display: grid;
    min-width: 10px;
    min-height: 22px;
    place-items: center;
    padding: 8px 2px;
  }

  .carousel-pagination button:first-child {
    padding-left: 8px;
  }

  .carousel-pagination button:last-child {
    padding-right: 8px;
  }

  .carousel-pagination span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .carousel-pagination button[aria-current="true"] span {
    opacity: 1;
  }

  @media (max-width: 1199.98px) {
    .reviews-container {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 80px;
      padding: 80px 40px;
    }

    .reviews-header,
    .reviews-placeholder,
    .reviews-carousel {
      width: 100%;
      max-width: none;
      flex: none;
    }

    .reviews-placeholder {
      display: none;
    }

    .reviews-carousel {
      height: 420px;
    }
  }

  @media (max-width: 809.98px) {
    .reviews-container {
      gap: 40px;
      padding: 64px 24px;
    }

    .reviews-header {
      gap: 24px;
    }

    .reviews-header .section-heading {
      width: 90%;
    }

    .reviews-carousel {
      height: 420px;
    }

    .carousel-viewport {
      height: 360px;
    }

    .carousel-track {
      height: 360px;
    }

    .review-card {
      width: calc(100% - 38px);
      min-width: calc(100% - 38px);
      padding: 24px;
    }
  }
</style>

<script>
  const viewport = document.getElementById("carouselViewport");
  const track = document.getElementById("carouselTrack");
  const cards = track ? Array.from(track.querySelectorAll<HTMLElement>(".review-card")) : [];
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-slide]"));

  if (track && cards.length > 0 && viewport) {
    let current = 0;
    let startX = 0;
    let dragX = 0;
    let dragging = false;

    const step = () => cards[0].getBoundingClientRect().width + 10;
    const render = (animate = true) => {
      track.style.transition = animate ? "transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)" : "none";
      track.style.transform = `translate3d(${-current * step() + dragX}px, 0, 0)`;
      cards.forEach((card, index) => card.setAttribute("aria-hidden", String(index !== current)));
      dots.forEach((dot, index) => {
        if (index === current) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    dots.forEach((dot, index) => dot.addEventListener("click", () => {
      current = index;
      dragX = 0;
      render();
    }));

    track.addEventListener("pointerdown", (event) => {
      dragging = true;
      startX = event.clientX;
      track.setPointerCapture(event.pointerId);
    });
    track.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      dragX = event.clientX - startX;
      render(false);
    });
    track.addEventListener("pointerup", (event) => {
      if (!dragging) return;
      dragging = false;
      if (Math.abs(dragX) > 40) current = Math.max(0, Math.min(cards.length - 1, current + (dragX < 0 ? 1 : -1)));
      dragX = 0;
      render();
      track.releasePointerCapture(event.pointerId);
    });
    window.addEventListener("resize", () => render(false));
    render(false);
  }
</script>
