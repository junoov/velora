---
---

<section class="hero-section" id="hero">
  <div class="hero-container">
    <div class="hero-top-row">
      <div class="hero-top-content">
        <h3 class="hero-welcome" data-hero="up" data-delay="0">Halo.</h3>
        <p class="hero-bio" data-hero="up" data-delay="0.1">
          Pengembang web full-stack yang membangun aplikasi responsif, aman, dan andal, mulai dari antarmuka hingga backend, database, dan deployment. Diperkuat dengan bekal jaringan komputer dan pengujian keamanan web.
        </p>
        <a href="#projects" class="link-underline" data-hero="up" data-delay="0.2">
          <span>Lihat proyek</span>
          <svg class="arrow-right" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
          <svg class="arrow-down" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <div class="hero-bottom-row">
      <div class="hero-profile">
        <div class="hero-image-wrap" data-hero="down" data-delay="0.1" data-hero-zoom>
          <img src="/assets/hero-portrait.png" alt="Portrait of Rizky Noviansyah" class="hero-portrait" width="1200" height="900" fetchpriority="high" />
        </div>
        <h1 class="hero-name" data-hero="down" data-delay="0">Rizky Noviansyah</h1>
      </div>

      <a href="https://github.com/junoov/" target="_blank" rel="noopener noreferrer" class="link-underline hero-scroll-link" data-hero="down" data-delay="0.2">
        <span>Full-Stack Developer · Lihat GitHub</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7V15"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    display: flex;
    width: 100%;
    min-height: 100vh;
    height: 100vh;
    max-height: 1024px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--bg-tint);
    padding-top: 64px;
  }

  .hero-container {
    display: flex;
    width: 100%;
    max-width: 1400px;
    height: 100%;
    flex: 1 0 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 32px;
    padding: 40px 80px 64px;
  }

  .hero-top-row {
    display: flex;
    width: 100%;
    flex: none;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .hero-top-content {
    display: flex;
    width: 35%;
    flex: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    overflow: hidden;
  }

  .hero-welcome {
    width: 100%;
    color: var(--text);
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 120%;
  }

  .arrow-down {
    display: none;
  }

  .hero-bio {
    width: 100%;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 140%;
  }

  .hero-bottom-row {
    z-index: 1;
    display: flex;
    width: 100%;
    min-height: 0;
    flex: 1 0 0;
    align-items: flex-end;
    justify-content: space-between;
  }

  .hero-profile {
    display: flex;
    width: 48%;
    height: 100%;
    flex: none;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 32px;
    overflow: visible;
  }

  .hero-image-wrap {
    width: 100%;
    max-width: 500px;
    max-height: 350px;
    flex: 0 0 auto;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--bg-card);
  }

  .hero-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s var(--ease-out);
  }

  .hero-image-wrap:hover .hero-portrait {
    transform: scale(1.04);
  }

  .hero-name {
    width: 100%;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 120%;
    white-space: nowrap;
  }

  .hero-scroll-link {
    margin-bottom: 8px;
  }

  @media (max-width: 1199.98px) {
    .hero-section {
      max-height: none;
    }

    .hero-container {
      gap: 48px;
      padding: 40px 40px 64px;
    }

    .hero-top-content,
    .hero-profile {
      width: 45%;
    }
  }

  @media (max-width: 809.98px) {
    .hero-section {
      min-height: 0;
      height: auto;
      max-height: none;
    }

    .hero-container {
      flex: none;
      gap: 64px;
      padding: 24px 24px 48px;
    }

    .hero-top-row {
      justify-content: flex-start;
    }

    .hero-top-content {
      width: 100%;
    }

    .hero-bottom-row {
      flex: none;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .hero-profile {
      width: 100%;
      height: auto;
      gap: 16px;
    }

    .hero-image-wrap {
      max-width: 500px;
    }

    .hero-name {
      font-size: var(--fs-h1);
      white-space: normal;
    }

    .hero-welcome {
      line-height: 130%;
    }

    .arrow-right {
      display: none;
    }

    .arrow-down {
      display: block;
    }

    .hero-scroll-link {
      display: none;
    }
  }
</style>

<script>
  // Live (Framer) scroll transform on the hero image wrapper, measured via CDP:
  // scrollY 0 -> 900 (one viewport) maps linearly to
  //   desktop (>=1200): scale 1 -> 1.14934, translateX 0 -> +37.83px, translateY 0 -> -27.88px
  //   tablet (810-1199): scale 1 -> 1.14668, translateX 0 -> +37.16px, translateY 0 -> -27.38px
  //   phone: no effect. Transform is applied directly (no smoothing) with origin center.
  (() => {
    const wrap = document.querySelector<HTMLElement>('[data-hero-zoom]');
    const hero = document.getElementById('hero');
    if (!wrap || !hero) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const media = window.matchMedia('(min-width: 810px)');
    let raf = 0;

    const apply = () => {
      raf = 0;
      if (!media.matches) {
        wrap.style.transform = '';
        return;
      }
      const range = Math.min(hero.offsetHeight, window.innerHeight) || 1;
      const progress = Math.min(Math.max(window.scrollY / range, 0), 1);
      const wide = window.matchMedia('(min-width: 1200px)').matches;
      const dScale = wide ? 0.14934 : 0.14668;
      const dX = wide ? 37.8319 : 37.1578;
      const dY = wide ? -27.8761 : -27.3794;
      wrap.style.transformOrigin = '50% 50%';
      wrap.style.transform = `translate3d(${(dX * progress).toFixed(2)}px, ${(dY * progress).toFixed(2)}px, 0) scale(${(1 + dScale * progress).toFixed(5)})`;
    };

    const tick = () => {
      if (!raf) raf = requestAnimationFrame(apply);
    };

    window.addEventListener('scroll', tick, { passive: true });
    window.addEventListener('resize', tick);
    if (media.addEventListener) media.addEventListener('change', tick);
    else media.addListener(tick);
    apply();
  })();
</script>
