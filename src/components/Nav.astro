---
const links = [
  { label: 'Works', href: '#works' },
  { label: 'Services', href: '#services' },
  { label: 'About', href: '#about' },
  { label: 'Reviews', href: '#review' },
  { label: 'Use Template', href: 'https://framer.link/AMSeDZ8' },
];
---

<header class="navbar" id="navbar">
  <nav class="nav-shell" aria-label="Primary navigation">
    <div class="nav-container">
      <a href="/" class="logo-link" aria-label="Velora home">Velora</a>

      <div class="nav-links">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', link.label === 'Use Template' && 'nav-link-template']}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>

      <button
        class="mobile-toggle"
        id="mobileToggle"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>

    <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
      <div class="mobile-nav-links">
        {links.map((link) => (
          <a
            href={link.href}
            class="mobile-link"
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<style>
  .navbar {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background: rgba(247, 245, 242, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .nav-shell {
    width: 100%;
    max-width: none;
    height: 64px;
    margin: 0 auto;
    overflow: hidden;
  }

  .nav-container {
    display: flex;
    width: 100%;
    max-width: 1400px;
    height: 64px;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    padding: 0 80px;
  }

  .logo-link {
    flex: none;
    padding: 4px;
    color: var(--text-secondary);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 140%;
    transition: opacity 0.4s var(--ease-link);
  }

  .logo-link:hover {
    opacity: 0.65;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-link,
  .mobile-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 4px;
    color: var(--text);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 140%;
    transition: color 0.4s var(--ease-link);
  }

  .nav-link::after,
  .mobile-link::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    content: '';
    opacity: 0;
    transition: width 0.4s var(--ease-link), opacity 0.4s var(--ease-link);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .mobile-link:hover::after,
  .mobile-link:focus-visible::after {
    width: 100%;
    opacity: 1;
  }

  .mobile-toggle,
  .mobile-drawer {
    display: none;
  }

  @media (max-width: 1199.98px) {
    .nav-container {
      padding-inline: 40px;
    }
  }

  @media (max-width: 809.98px) {
    .navbar,
    .nav-shell,
    .nav-container {
      height: auto;
    }

    .nav-shell {
      max-width: 390px;
      overflow: hidden;
    }

    .nav-container {
      height: 64px;
      padding-inline: 24px;
    }

    .nav-links {
      display: none;
    }

    .mobile-toggle {
      display: flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
    }

    .menu-icon {
      display: flex;
      width: 20px;
      height: 20px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .menu-icon span {
      display: block;
      width: 20px;
      height: 1.5px;
      background: var(--text);
      transition: transform 0.4s var(--ease-link);
    }

    .mobile-drawer {
      display: block;
      width: 100%;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.55s var(--ease-out), opacity 0.35s var(--ease-link);
    }

    .mobile-nav-links {
      display: flex;
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 8px 24px 40px;
    }

    .mobile-link {
      width: 100%;
      font-size: 24px;
    }

    .navbar.menu-open {
      height: auto;
    }

    .navbar.menu-open .mobile-drawer {
      max-height: 360px;
      opacity: 1;
    }

    .navbar.menu-open .menu-icon span:first-child {
      transform: translateY(3.75px) rotate(45deg);
    }

    .navbar.menu-open .menu-icon span:last-child {
      transform: translateY(-3.75px) rotate(-45deg);
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobileToggle');
  const navbar = document.getElementById('navbar');
  const drawer = document.getElementById('mobileDrawer');

  if (toggle && navbar && drawer) {
    const closeMenu = () => {
      navbar.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
    };

    toggle.addEventListener('click', () => {
      const isOpen = navbar.classList.toggle('menu-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      drawer.setAttribute('aria-hidden', String(!isOpen));
    });

    drawer.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    window.addEventListener('resize', () => {
      if (window.innerWidth > 809.98) closeMenu();
    });
  }
</script>
