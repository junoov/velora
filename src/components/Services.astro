---
const services = [
  {
    num: "01",
    title: "Graphic Design",
    description: "Creating visually compelling designs that elevate your brand and captivate your audience.",
    image: "/assets/service-graphic.jpg"
  },
  {
    num: "02",
    title: "Lifestyle Photography",
    description: "Capturing authentic moments that bring your brand to life.",
    image: "/assets/service-lifestyle.jpg"
  },
  {
    num: "03",
    title: "Digital Design",
    description: "Intuitive and aesthetically pleasing digital experiences.",
    image: "/assets/service-digital.jpg"
  },
  {
    num: "04",
    title: "Social Media Design",
    description: "Engaging visuals that strengthen your online presence.",
    image: "/assets/service-social.jpg"
  }
];
const summary = "From strategy to execution, I offer thoughtful and tailored design solutions that bring your unique vision to life.";
---

<section class="services-section" id="services">
  <div class="container-wide">
    <div class="section-header">
      <div class="section-heading">
        <div class="section-dash"></div>
        <h2 class="section-label-text">Services</h2>
      </div>
      <p class="section-summary" data-words>
        {summary.split(/\s+/).map((word, index, words) => (
          <>
            <span class="word">{word}</span>
            {index < words.length - 1 ? ' ' : ''}
          </>
        ))}
      </p>
    </div>

    <div class="service-list">
      {services.map((service) => (
        <article class="service-row">
          <span class="service-num">{service.num}</span>
          <div class="service-content">
            <div class="service-main">
              <h5 class="service-title" data-reveal="sm">{service.title}</h5>
              <p class="service-desc" data-reveal="sm">{service.description}</p>
            </div>
          </div>
          <div class="service-image-wrap" data-reveal="sm">
            <img src={service.image} alt={service.title} class="service-image" width="1024" height="768" loading="lazy" />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    width: 100%;
    display: flex;
    justify-content: center;
    background: var(--bg);
  }

  .services-section .container-wide {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 80px;
    padding: 80px;
  }

  .service-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .service-row {
    position: sticky;
    top: 120px;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 12px 0;
    background: var(--bg);
  }

  .service-row + .service-row {
    margin-top: 1px;
  }

  .service-row + .service-row::before {
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--line);
    content: "";
  }

  .service-num {
    position: absolute;
    top: -46px;
    left: 0;
    z-index: 1;
    color: var(--text-faint);
    font-size: 13px;
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .service-content {
    width: 60%;
    display: flex;
    align-items: center;
  }

  .service-main {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .service-title {
    width: 40%;
    flex: none;
    color: var(--text);
    font-size: var(--fs-h5);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.05em;
  }

  .service-desc {
    flex: 1;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .service-image-wrap {
    flex: 1;
    height: 180px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--bg-subtle);
  }

  .service-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .service-row:hover .service-image,
  .service-row:focus-within .service-image {
    transform: scale(1.04);
  }

  @media (max-width: 1199.98px) {
    .services-section .container-wide {
      gap: 80px;
      padding: 80px 40px;
    }

    .service-content {
      flex: 1 0 0;
      width: 1px;
    }

    .service-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .service-title,
    .service-desc {
      width: 100%;
    }

    .service-desc {
      flex: none;
    }
  }

  @media (max-width: 809.98px) {
    .services-section .container-wide {
      gap: 40px;
      padding: 64px 24px;
    }

    .service-list {
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .service-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 24px 0;
      border-top: 0;
    }

    .service-num {
      position: static;
      order: 0;
      margin-bottom: 12px;
    }

    .service-content {
      flex: none;
      width: 100%;
      order: 1;
    }

    .service-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .service-title,
    .service-desc {
      width: 100%;
      flex: none;
    }

    .service-image-wrap {
      flex: none;
      width: 100%;
      height: auto;
      margin-top: 16px;
      aspect-ratio: 2.785;
      order: 2;
    }
  }
</style>
