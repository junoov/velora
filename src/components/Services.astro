---
const services = [
  {
    num: "01",
    title: "Pengembangan Frontend",
    description: "Antarmuka responsif dan mudah diakses dengan struktur komponen yang rapi serta interaksi yang matang.",
    note: "Layout, komponen, dan aksesibilitas.",
    image: "/assets/capability-frontend.svg",
    alt: "Poster tipografi FE untuk pengembangan frontend"
  },
  {
    num: "02",
    title: "Pengembangan Backend",
    description: "Logika sisi server, autentikasi, dan integrasi database untuk aplikasi yang benar-benar jalan.",
    note: "Auth, database, dan logika server.",
    image: "/assets/capability-backend.svg",
    alt: "Poster tipografi BE untuk pengembangan backend"
  },
  {
    num: "03",
    title: "Jaringan Komputer",
    description: "Dasar-dasar jaringan dengan latihan langsung memakai Cisco, mulai dari subnetting, routing, hingga troubleshooting.",
    note: "Subnetting, routing, dan Cisco.",
    image: "/assets/capability-network.svg",
    alt: "Poster tipografi NET untuk jaringan komputer"
  },
  {
    num: "04",
    title: "Keamanan Aplikasi",
    description: "Pengembangan yang sadar keamanan dan pengujian kerentanan web berbasis OWASP, termasuk pemakaian OWASP ZAP.",
    note: "OWASP, ZAP, dan pengujian kerentanan.",
    image: "/assets/capability-security.svg",
    alt: "Poster tipografi SEC untuk keamanan aplikasi"
  }
];
const summary = "Saya membangun aplikasi web secara menyeluruh, dari antarmuka hingga deployment, dengan bekal jaringan komputer dan keamanan web.";
---

<section class="services-section" id="capabilities">
  <div class="container-wide">
    <div class="section-header">
      <div class="section-heading">
        <div class="section-dash"></div>
        <h2 class="section-label-text">Kemampuan</h2>
      </div>
      <p class="section-summary" data-words>
        {summary.split(/\s+/).map((word, index, words) => (
          <>
            <span class="word">{word}</span>
            {index < words.length - 1 ? ' ' : ''}
          </>
        ))}
      </p>
    </div>

    <div class="service-list">
      {services.map((service) => (
        <article class="service-row">
          <span class="service-num">{service.num}</span>
          <div class="service-content">
            <div class="service-main">
              <h5 class="service-title" data-reveal="sm">{service.title}</h5>
              <p class="service-desc" data-reveal="sm">{service.description}</p>
            </div>
          </div>
          <div class="service-image-wrap" data-reveal="sm">
            <img src={service.image} alt={service.alt} class="service-image" width="1200" height="540" loading="lazy" />
            <p class="service-note">{service.note}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    width: 100%;
    display: flex;
    justify-content: center;
    background: var(--bg);
  }

  .services-section .container-wide {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 80px;
    padding: 80px;
  }

  .service-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .service-row {
    position: sticky;
    top: 120px;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 12px 0;
    background: var(--bg);
  }

  .service-row + .service-row {
    margin-top: 1px;
  }

  .service-row + .service-row::before {
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--line);
    content: "";
    transition: background 0.3s var(--ease-out);
  }

  .service-row:hover::before,
  .service-row:focus-within::before {
    background: var(--line-hover);
  }

  .service-num {
    position: absolute;
    top: -46px;
    left: 0;
    z-index: 1;
    color: var(--text-faint);
    font-size: 13px;
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .service-content {
    width: 60%;
    display: flex;
    align-items: center;
  }

  .service-main {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .service-title {
    width: 40%;
    flex: none;
    color: var(--text);
    font-size: var(--fs-h5);
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.05em;
  }

  .service-desc {
    flex: 1;
    color: var(--text-muted);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.04em;
  }

  .service-image-wrap {
    flex: 1;
    position: relative;
    height: 180px;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--project-edge);
    background: var(--bg-subtle);
  }

  .service-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.99);
    transition: filter 0.45s var(--ease-out), transform 0.6s var(--ease-out);
  }

  .service-row:hover .service-image,
  .service-row:focus-within .service-image {
    filter: grayscale(1) brightness(0.96) blur(4px);
    transform: scale(1.02);
  }

  .service-note {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 20px;
    background: rgba(250, 250, 250, 0.78);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    line-height: 140%;
    letter-spacing: -0.02em;
    text-align: center;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }

  .service-row:hover .service-note,
  .service-row:focus-within .service-note {
    opacity: 1;
  }

  @media (max-width: 1199.98px) {
    .services-section .container-wide {
      gap: 80px;
      padding: 80px 40px;
    }

    .service-content {
      flex: 1 0 0;
      width: 1px;
    }

    .service-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .service-title,
    .service-desc {
      width: 100%;
    }

    .service-desc {
      flex: none;
    }
  }

  @media (max-width: 809.98px) {
    .services-section .container-wide {
      gap: 40px;
      padding: 64px 24px;
    }

    .service-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 24px 0;
    }

    .service-num {
      position: static;
      order: 0;
      margin-bottom: 12px;
    }

    .service-content {
      flex: none;
      width: 100%;
      order: 1;
    }

    .service-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .service-title,
    .service-desc {
      width: 100%;
      flex: none;
    }

    .service-image-wrap {
      flex: none;
      width: 100%;
      height: auto;
      margin-top: 16px;
      aspect-ratio: 2.785;
      order: 2;
    }

    .service-note {
      inset: auto 0 0 0;
      justify-content: flex-start;
      padding: 10px 14px;
      text-align: left;
      opacity: 1;
      background: rgba(250, 250, 250, 0.85);
    }
  }
</style>
